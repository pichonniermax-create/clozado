{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // « site » est une AUTRE application Next, avec son propre tsconfig et son propre alias « @/ » (qui pointe
  // sa racine, pas `src`). Sans cette exclusion, le typecheck du produit lit ses fichiers avec le mauvais alias
  // et échoue sur des modules introuvables — et `next build` du produit échoue avec lui.
  "exclude": ["node_modules", "site"]
}
