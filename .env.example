# Copie ce fichier en .env.local et remplis les valeurs (ne jamais committer .env.local)

# URL de connexion à la base Neon (Postgres)
DATABASE_URL=

# Clé secrète Auth.js (génère avec: openssl rand -base64 32)
AUTH_SECRET=

# Clé API Resend, pour l'envoi des emails de connexion (resend.com -> API Keys)
RESEND_API_KEY=
# Adresse d'envoi. onboarding@resend.dev fonctionne sans configurer de domaine.
EMAIL_FROM=onboarding@resend.dev

# Clé API Anthropic, pour la génération de newsletters par l'IA (console.anthropic.com)
ANTHROPIC_API_KEY=
# Override du modèle principal (défaut: claude-sonnet-5)
ANTHROPIC_MODEL=
