# Copie ce fichier en .env.local et remplis les valeurs (ne jamais committer .env.local)

# URL de connexion à la base Neon (Postgres)
DATABASE_URL=

# Clé secrète Auth.js (génère avec: openssl rand -base64 32)
AUTH_SECRET=

# Clé API Resend, pour l'envoi des emails de connexion (resend.com -> API Keys)
RESEND_API_KEY=
# Adresse d'envoi. onboarding@resend.dev fonctionne sans configurer de domaine.
EMAIL_FROM=onboarding@resend.dev

# Clé API Anthropic, pour la génération de newsletters par l'IA (console.anthropic.com)
ANTHROPIC_API_KEY=
# Override du modèle principal (défaut: claude-sonnet-5)
ANTHROPIC_MODEL=

# --- Chantier engagement (docs/module-engagement.md §7) ---
# L'origine publique de l'application, pour les liens composés hors requête (cron, webhooks, désinscription)
APP_URL=
# L'expéditeur des emails du produit — une adresse RÉELLE sur le sous-domaine mutualisé (plus jamais onboarding@resend.dev)
# EMAIL_FROM=Clozado <connexion@mail.clozado.fr>
# Le sous-domaine mutualisé d'envoi (repli tant qu'une organisation n'a pas vérifié son domaine)
EMAIL_SHARED_DOMAIN=mail.clozado.fr
# Le domaine de réception des adresses d'ingestion (<jeton>@in.clozado.fr)
EMAIL_INBOUND_DOMAIN=in.clozado.fr
# Le secret de signature des webhooks Resend (tableau de bord Resend → Webhooks → <APP_URL>/api/webhooks/resend)
RESEND_WEBHOOK_SECRET=
# Le secret des crons Vercel (Authorization: Bearer) — sans lui, les routes de cron refusent
CRON_SECRET=
