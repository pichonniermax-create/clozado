# Copie ce fichier en .env.local et remplis les valeurs (ne jamais committer .env.local).
# Les variables sont validées au démarrage du serveur (src/env.ts) : les trois premières sont
# indispensables (sans elles aucune page ne fonctionne), les autres désactivent une fonction précise.

# --- Indispensables ---

# La base Postgres (Neon) — lue à l'import par src/db/index.ts
DATABASE_URL=

# La clé secrète d'Auth.js : les sessions, la session de visite de la démo et le chiffrement
# des secrets en base en dérivent (génère avec : openssl rand -base64 32)
AUTH_SECRET=

# L'expéditeur des emails du PRODUIT (lien de connexion) : une adresse RÉELLE sur le
# sous-domaine mutualisé d'envoi — jamais une adresse de test du fournisseur
# (src/lib/email/config.ts la refuse). Exemple : Clozado <connexion@mail.clozado.fr>
EMAIL_FROM=

# --- Envoi et réception d'emails (chantier engagement, docs/module-engagement.md §7) ---

# La clé API Resend (resend.com → API Keys) : sans elle, aucun email ne part (lien de connexion,
# newsletters, relances) et la vérification des domaines est indisponible
RESEND_API_KEY=

# Le sous-domaine mutualisé d'envoi — l'expéditeur de repli de toute organisation sans domaine vérifié
EMAIL_SHARED_DOMAIN=mail.clozado.fr

# Le domaine de réception des adresses d'ingestion (<jeton>@in.clozado.fr)
EMAIL_INBOUND_DOMAIN=in.clozado.fr

# Le secret de signature des webhooks Resend (tableau de bord Resend → Webhooks →
# <APP_URL>/api/webhooks/resend) : sans lui, les webhooks (ouvertures, clics, rebonds, emails reçus)
# répondent 503
RESEND_WEBHOOK_SECRET=

# --- Séparation des flux (audit newsletter du 2026-09-17, §B.8) ---
# Les variables ci-dessus sont celles du flux TRANSACTIONNEL (lien de connexion, invitations,
# notifications, réception des emails d'ingestion). Tout ce qui part AU NOM D'UNE ORGANISATION
# (newsletters, tests, relances) et les domaines d'expédition des organisations passent par un
# SECOND compte Resend : ses seuils de plaintes et de rebonds, sa liste de suppression et une
# éventuelle fermeture ne touchent jamais les liens de connexion. Tant que ces trois variables sont
# absentes, le flux marketing passe par le compte transactionnel, comme avant, et le journal du
# serveur le dit une fois (email_marketing_flow_not_isolated).

# La clé API du compte Resend MARKETING (second compte, pas une seconde clé du même compte)
RESEND_MARKETING_API_KEY=

# Le sous-domaine mutualisé du flux marketing, vérifié dans le compte marketing — l'expéditeur de
# repli <slug>@<domaine> de toute organisation sans domaine vérifié (exemple : news.clozado.fr)
EMAIL_MARKETING_DOMAIN=

# Le secret de signature des webhooks du compte marketing (même URL <APP_URL>/api/webhooks/resend)
RESEND_MARKETING_WEBHOOK_SECRET=

# L'origine publique de l'application (https://app.clozado.fr), pour les liens absolus composés
# hors requête (désinscription depuis le cron, webhooks) ; à défaut, l'origine de la requête courante
APP_URL=

# --- Crons ---

# Le secret des crons Vercel (Authorization: Bearer) : sans lui, les routes de cron refusent (503)
CRON_SECRET=

# --- IA ---

# La clé API Anthropic (console.anthropic.com) : sans elle, le composer de newsletters, la veille par
# modèle et la lecture des signatures des emails reçus sont indisponibles — le déterministe seul
ANTHROPIC_API_KEY=

# Le modèle du composer de newsletters (défaut : claude-sonnet-5)
ANTHROPIC_MODEL=

# Le modèle de la veille (résumés, recherches) ; à défaut, ANTHROPIC_MODEL, sinon claude-sonnet-5
ANTHROPIC_WATCH_MODEL=

# --- Hors Vercel seulement ---

# Auth.js n'accepte l'hôte de la requête que s'il est de confiance : posé par Vercel ; à mettre à
# `true` en local ou chez un autre hébergeur
# AUTH_TRUST_HOST=true

# --- Base LOCALE de preuve (docs/module-demo.md §1.5), jamais en production ---

# Un Postgres Docker derrière le proxy HTTP compatible Neon : DATABASE_URL pointe le Postgres local
# (postgres://postgres:postgres@localhost:5432/main) et cette variable route le pilote vers le proxy
# DATABASE_HTTP_ENDPOINT=http://localhost:4444/sql
