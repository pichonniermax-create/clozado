{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "redirects": [
    {
      "source": "/",
      "destination": "/fr",
      "statusCode": 301
    },
    {
      "source": "/offre",
      "destination": "/fr/demo",
      "statusCode": 301
    },
    {
      "source": "/crm-courtier-assurance",
      "destination": "/fr/courtiers",
      "statusCode": 301
    },
    {
      "source": "/crm-gestion-patrimoine",
      "destination": "/fr/cgp",
      "statusCode": 301
    },
    {
      "source": "/crm-promotion-immobiliere",
      "destination": "/fr/immobilier",
      "statusCode": 301
    },
    {
      "source": "/contact",
      "destination": "/fr/demo",
      "statusCode": 301
    },
    {
      "source": "/references",
      "destination": "/fr",
      "statusCode": 301
    },
    {
      "source": "/mentions-legales",
      "destination": "/fr/mentions-legales",
      "statusCode": 301
    },
    {
      "source": "/confidentialite",
      "destination": "/fr/confidentialite",
      "statusCode": 301
    },
    {
      "source": "/login",
      "destination": "https://app.clozado.fr/login",
      "statusCode": 308
    },
    {
      "source": "/connexion",
      "destination": "https://app.clozado.fr",
      "statusCode": 308
    },
    {
      "source": "/signin",
      "destination": "https://app.clozado.fr",
      "statusCode": 308
    },
    {
      "source": "/sign-in",
      "destination": "https://app.clozado.fr",
      "statusCode": 308
    },
    {
      "source": "/app",
      "destination": "https://app.clozado.fr",
      "statusCode": 308
    },
    {
      "source": "/inscription",
      "destination": "https://app.clozado.fr",
      "statusCode": 308
    },
    {
      "source": "/signup",
      "destination": "https://app.clozado.fr",
      "statusCode": 308
    },
    {
      "source": "/tarifs",
      "destination": "/fr/demo",
      "statusCode": 308
    },
    {
      "source": "/fr/tarifs",
      "destination": "/fr/demo",
      "statusCode": 308
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000"
        }
      ]
    }
  ]
}
