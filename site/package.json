{
  "name": "clozado-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run verifier && eslint && next build && npm run depouiller && npm run verifier:poids",
    "start": "node scripts/servir.mjs",
    "lint": "eslint",
    "verifier": "npm run verifier:libelles && npm run verifier:espacement && npm run verifier:collisions && npm run verifier:additions",
    "verifier:libelles": "node scripts/verifier-libelles.mjs",
    "verifier:espacement": "node scripts/verifier-espacement.mjs",
    "verifier:collisions": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verifier-collisions.mjs",
    "verifier:additions": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verifier-additions.mjs",
    "depouiller": "node scripts/depouiller.mjs",
    "verifier:poids": "node scripts/verifier-poids.mjs"
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
